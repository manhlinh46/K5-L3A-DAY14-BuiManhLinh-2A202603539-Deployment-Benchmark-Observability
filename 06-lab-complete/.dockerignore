# ASCII only: some remote builders (Railway) send these patterns in an HTTP header.

# Secrets - never ship into the image
.env
.env.*
!.env.example

# Python cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Virtualenv
venv/
.venv/
env/

# Git, IDE, docs, Part 7, grading script - not needed at runtime
.git/
.gitignore
.vscode/
.idea/
*.md
benchmark-observability/
check_production_ready.py
docker-compose.yml
railway.toml
render.yaml
