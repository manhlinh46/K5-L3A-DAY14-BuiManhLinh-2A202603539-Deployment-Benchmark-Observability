# ============================================================
# Biến môi trường của agent. Dùng: cp .env.example .env  (.env đã nằm trong .gitignore)
# KHÔNG ghi secret thật vào file này.
# ============================================================
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret — đặt giá trị thật trong .env (local) hoặc trên dashboard Railway/Render
AGENT_API_KEY=change-me

# Redis (docker compose ghi đè thành redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
